{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NorthwindConnection": "SET_VIA_USER_SECRETS_OR_ENV"
  },
  "Cors": {
    "OriginCors": ["http://localhost:50346"]
  },
  "Jwt": {
    "Key": "SET_VIA_USER_SECRETS_OR_ENV",
    "Issuer": "Pacogroup.Ecommerce",
    "Audience": "Pacogroup.Ecommerce.Users"
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Health Checks API",
        "Uri": "/health"
      }
    ],
    "EvaluationTimeInSeconds": 1
  }
}
